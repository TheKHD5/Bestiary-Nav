<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <Version>0.5.6</Version>
    <Author>TheKHD5</Author>
    <Name>Bestiary Nav</Name>
    <RepoUrl>https://github.com/TheKHD5/Bestiary-Nav</RepoUrl>
    <Punchline>Find your next capture.</Punchline>
    <Description>Click a Bestiary entry to find its capture location or duty. Highlight nearby uncaptured beasts and optionally travel to them with Lifestream and vnavmesh. /bnav opens the Bestiary; /bnav config opens settings.</Description>
    <Tags>beastmaster;map;bestiary</Tags>
    <IconUrl>https://raw.githubusercontent.com/TheKHD5/Bestiary-Nav/v$(Version)/assets/icon.png</IconUrl>
    <ImageUrls>https://raw.githubusercontent.com/TheKHD5/Bestiary-Nav/v$(Version)/assets/screenshots/uncaptured-overview.png;https://raw.githubusercontent.com/TheKHD5/Bestiary-Nav/v$(Version)/assets/screenshots/uncaptured-detail.png</ImageUrls>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="locations.json" LogicalName="BestiaryNav.locations.json" />
    <EmbeddedResource Include="binding.json" LogicalName="BestiaryNav.binding.json" />
    <EmbeddedResource Include="capture-targets.json" LogicalName="BestiaryNav.capture-targets.json" />
  </ItemGroup>
</Project>
