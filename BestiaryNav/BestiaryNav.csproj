<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <Version>0.6.4</Version>
    <InstallerChangelogFile>$(MSBuildProjectDirectory)/../releases/v$(Version).installer.txt</InstallerChangelogFile>
    <Changelog Condition="Exists('$(InstallerChangelogFile)')">$([System.IO.File]::ReadAllText('$(InstallerChangelogFile)').Trim())</Changelog>
    <Author>TheKHD5</Author>
    <Name>Bestiary Nav</Name>
    <RepoUrl>https://github.com/TheKHD5/Bestiary-Nav</RepoUrl>
    <Punchline>Find your next capture.</Punchline>
    <Description>Click a Bestiary entry to find its capture location or duty. Highlight nearby uncaptured beasts and optionally travel to them with Lifestream and vnavmesh. /bnav opens the Bestiary; /bnav config opens settings.</Description>
    <Tags>beastmaster;map;bestiary</Tags>
    <!-- Keep unchanged images pinned to an existing tag, independently of plugin updates. -->
    <InstallerImageTag>v0.5.6</InstallerImageTag>
    <IconUrl>https://cdn.jsdelivr.net/gh/TheKHD5/Bestiary-Nav@$(InstallerImageTag)/assets/icon.png</IconUrl>
    <ImageUrls>https://cdn.jsdelivr.net/gh/TheKHD5/Bestiary-Nav@$(InstallerImageTag)/assets/screenshots/uncaptured-overview.png;https://cdn.jsdelivr.net/gh/TheKHD5/Bestiary-Nav@$(InstallerImageTag)/assets/screenshots/uncaptured-detail.png</ImageUrls>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="locations.json" LogicalName="BestiaryNav.locations.json" />
    <EmbeddedResource Include="binding.json" LogicalName="BestiaryNav.binding.json" />
    <EmbeddedResource Include="capture-targets.json" LogicalName="BestiaryNav.capture-targets.json" />
    <EmbeddedResource Include="collection.json" LogicalName="BestiaryNav.collection.json" />
  </ItemGroup>
</Project>
