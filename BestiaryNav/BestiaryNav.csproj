<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <Version>0.5.4</Version>
    <Author>BestiaryNav contributors</Author>
    <Name>Bestiary Nav</Name>
    <RepoUrl>https://github.com/TheKHD5/Bestiary-Nav</RepoUrl>
    <Punchline>Navigate to beasts and highlight nearby uncaptured targets.</Punchline>
    <Description>Left-click Master's Bestiary entries to open acquisition map flags or select their duty in Duty Finder. Highlight nearby uncaptured beasts with level-colored model and enemy-list labels. Use the Auto Navigate toggle for optional teleporting and walking through Lifestream and vnavmesh (both required for automatic travel). Includes all 50 beasts and quest guidance. Use /bnav for settings.</Description>
    <Tags>beastmaster;map;bestiary</Tags>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="locations.json" LogicalName="BestiaryNav.locations.json" />
    <EmbeddedResource Include="binding.json" LogicalName="BestiaryNav.binding.json" />
    <EmbeddedResource Include="capture-targets.json" LogicalName="BestiaryNav.capture-targets.json" />
  </ItemGroup>
</Project>
